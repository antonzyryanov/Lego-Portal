# Environment & secrets
.env
.env.backup
.env.production
.env.*.local
!.env.example

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
.cursor/
*.swp
*.swo

# Dependencies & build
**/node_modules/
**/vendor/
**/public/build/
**/public/hot
**/bootstrap/cache/*.php
!**/bootstrap/cache/.gitignore

# Laravel storage noise
**/storage/*.key
**/storage/logs/*
!**/storage/logs/.gitignore
**/storage/framework/cache/data/*
**/storage/framework/sessions/*
**/storage/framework/views/*
!**/storage/framework/**/.gitignore

# SQLite databases
*.db
*.db-journal
*.db-wal
*.db-shm
**/database/*.sqlite

# Persistent Docker DB bind mounts (keep folder structure)
/data/web/*
!/data/web/.gitkeep
/data/metrics/*
!/data/metrics/.gitkeep

# Go
**/metrics/bin/
**/metrics/tmp/
*.exe
*.test

# Docker
docker-data/

# Logs & caches
*.log
.phpunit.result.cache
.phpactor.json
.npmrc.local

# Coverage / test
coverage/
.htmlcov/
