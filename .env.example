# Lego Portal — copy to .env and adjust as needed
# cp .env.example .env

APP_NAME="Lego Portal"
APP_ENV=local
APP_KEY=base64:ky4iXTOKF4CuWCcNsZ+DUXxBMzO0ks4Uq1wWQ/JUCiU=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Web SQLite (shared Docker volume mounted at /data)
DB_CONNECTION=sqlite
DB_DATABASE=/data/lego.db
DB_FOREIGN_KEYS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Default admin (created by database seeder on first boot)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@lego.local
ADMIN_PASSWORD=password

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=lego
RABBITMQ_PASSWORD=lego_secret
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=lego.metrics
RABBITMQ_URL=amqp://lego:lego_secret@rabbitmq:5672/
RABBITMQ_DEFAULT_USER=lego
RABBITMQ_DEFAULT_PASS=lego_secret

# Metrics service
METRICS_SERVICE_URL=http://metrics
METRICS_API_TOKEN=lego_metrics_token_change_me
METRICS_DB_PATH=/data/metrics.db
PORT=8081

# Entrypoint
RUN_SEEDERS=true

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@lego.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
